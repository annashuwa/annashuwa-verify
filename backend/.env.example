# Copy to .env and fill in. NEVER commit a filled .env with real secrets.
NODE_ENV=development
PORT=4000
# Comma-separated allowed frontend origins (include 127.0.0.1 variant for local dev)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/naija_verify
# If MONGODB_URI is unreachable and USE_MEMORY_DB=true, backend uses in-memory Mongo (dev/test only)
USE_MEMORY_DB=true
JWT_ACCESS_SECRET=change-me-access-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# General API rate limit (requests/min/IP). Sensitive surfaces have their own
# tighter limits (auth 60/15min, external v1 per-key 60/min).
API_RATE_LIMIT_PER_MIN=600
# Mock provider behaviour: MOCK_MODE=success | mixed (mixed honours failure markers in test IDs)
MOCK_MODE=mixed
MOCK_DEFAULT_LATENCY_MS=120
# Mock payment provider
PAYMENT_PROVIDER=mock
# Seed admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
# ---------------------------------------------------------------------------
# Provider layer
# PROVIDER_MODE=mock → deterministic test doubles for every vendor (default).
# PROVIDER_MODE=live → real adapters; vendors without credentials are skipped.
# ---------------------------------------------------------------------------
PROVIDER_MODE=mock
# Per-attempt provider timeout + bounded retry (safe failures only: 5xx/429/network)
PROVIDER_TIMEOUT_MS=8000
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_DELAY_MS=750
# Reconciliation of stale transactions (processing / refund_pending)
RECONCILE_INTERVAL_MS=60000
RECONCILE_STALE_AFTER_MS=120000
RECONCILE_MAX_ATTEMPTS=10
# In live mode, ambiguous provider timeouts stay `processing` for the
# reconciler instead of auto-refunding (the vendor may have completed).
RECONCILE_AMBIGUOUS=true
# Inbound provider-webhook timestamp skew tolerance
WEBHOOK_MAX_SKEW_MS=300000
# ---------------------------------------------------------------------------
# Real vendor credentials — server-side ONLY. Leave empty to keep mocks.
# Map each vendor's official endpoint paths from its API documentation.
# A vendor activates only when BASE_URL + API_KEY + at least one PATH is set.
# ---------------------------------------------------------------------------
# Ninja
NINJA_BASE_URL=
NINJA_API_KEY=
# NINJA_AUTH_HEADER=Authorization: Bearer {key}
# NINJA_METHOD=POST
# NINJA_PATH_NIN_LOOKUP=
# NINJA_PATH_NIN_PHONE=
# NINJA_PATH_NIN_DEMOGRAPHICS=
# NINJA_PATH_BVN_LOOKUP=
# NINJA_PATH_STATUS=
# NINJA_PATH_BALANCE=
# NINJA_PATH_HEALTH=
# NINJA_DEFAULT_COST_KOBO=15000
# Dojah
DOJAH_BASE_URL=
DOJAH_API_KEY=
# DOJAH_AUTH_HEADER=Authorization: Bearer {key}
# DOJAH_METHOD=POST
# DOJAH_PATH_NIN_LOOKUP=
# DOJAH_PATH_NIN_PHONE=
# DOJAH_PATH_NIN_DEMOGRAPHICS=
# DOJAH_PATH_BVN_LOOKUP=
# DOJAH_PATH_BVN_PHONE=
# DOJAH_PATH_CAC=
# DOJAH_PATH_STATUS=
# DOJAH_PATH_BALANCE=
# DOJAH_PATH_HEALTH=
# DOJAH_DEFAULT_COST_KOBO=15000
# Prembly
PREMBLY_BASE_URL=
PREMBLY_API_KEY=
# PREMBLY_AUTH_HEADER=Authorization: Bearer {key}
# PREMBLY_METHOD=POST
# PREMBLY_PATH_NIN_LOOKUP=
# PREMBLY_PATH_BVN_LOOKUP=
# PREMBLY_PATH_CAC=
# PREMBLY_PATH_STATUS=
# PREMBLY_PATH_BALANCE=
# PREMBLY_PATH_HEALTH=
# PREMBLY_DEFAULT_COST_KOBO=15000
# VerifyMe
VERIFYME_BASE_URL=
VERIFYME_API_KEY=
# VERIFYME_AUTH_HEADER=Authorization: Bearer {key}
# VERIFYME_METHOD=POST
# VERIFYME_PATH_NIN_LOOKUP=
# VERIFYME_PATH_BVN_LOOKUP=
# VERIFYME_PATH_CAC=
# VERIFYME_PATH_STATUS=
# VERIFYME_PATH_BALANCE=
# VERIFYME_PATH_HEALTH=
# VERIFYME_DEFAULT_COST_KOBO=15000
# IdentifyOrg
IDENTIFYORG_BASE_URL=
IDENTIFYORG_API_KEY=
# IDENTIFYORG_AUTH_HEADER=Authorization: Bearer {key}
# IDENTIFYORG_METHOD=POST
# IDENTIFYORG_PATH_NIN_LOOKUP=
# IDENTIFYORG_PATH_BVN_LOOKUP=
# IDENTIFYORG_PATH_CAC=
# IDENTIFYORG_PATH_STATUS=
# IDENTIFYORG_PATH_BALANCE=
# IDENTIFYORG_PATH_HEALTH=
# IDENTIFYORG_DEFAULT_COST_KOBO=15000
# Inbound provider-webhook secrets (set the VALUE here; reference the NAME in
# the Provider document's webhookSecretName field, e.g. NINJA_WEBHOOK_SECRET)
# NINJA_WEBHOOK_SECRET=
# DOJAH_WEBHOOK_SECRET=
# PREMBLY_WEBHOOK_SECRET=
# Wallet funding gateways (future)
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
